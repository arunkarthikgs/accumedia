generator client {
  provider        = "prisma-client-js"
  engineType      = "client"
  previewFeatures = ["driverAdapters", "multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["macula"]
}

enum UserRole {
  PHYSICIAN
  ADMIN
  COMPLIANCE_OFFICER

  @@schema("macula")
}

enum CaseStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SCHEDULED
  EXPORTED
  PUBLISHED

  @@schema("macula")
}

// RFP §17 — content status flow applied per generated asset, independently
// of the case-level MCCR status above. Regenerating/approving one platform
// output must never require touching the others.
enum AssetStatus {
  DRAFT
  REVIEW
  APPROVED
  SCHEDULED
  EXPORTED
  PUBLISHED

  @@schema("macula")
}

enum PublicationStatus {
  QUEUED
  PROCESSING
  PUBLISHED
  FAILED
  CANCELLED

  @@schema("macula")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED

  @@schema("macula")
}

// RFP §16 — safety flags are detected, never silently resolved. A flag is
// either open (blocks approval) or has an explicit human decision recorded.
enum SafetyFlagStatus {
  OPEN
  REVIEWED_OK
  REVIEWED_REDACTED
  REJECTED

  @@schema("macula")
}

enum SafetyFlagTargetType {
  CASE
  GENERATED_ASSET
  IMAGE_ASSET

  @@schema("macula")
}

// RFP §7-12 — the fixed set of required output types. ChannelDefinition rows
// reference one of these so the Adaptation Engine knows which prompt/schema
// to use, instead of the LLM inventing arbitrary channel drafts.
enum OutputType {
  VIDEO_SCRIPT
  LINKEDIN_ARTICLE
  LINKEDIN_SHORT_POST
  FACEBOOK_POST
  X_POST
  YOUTUBE_REELS_METADATA
  SEO_BLOG

  @@schema("macula")
}

model Organization {
  id                 String              @id @default(uuid())
  name               String
  slug               String              @unique
  brandingHex        String?             @default("#0f766e")
  logoUrl            String?
  brandFont          String?             @default("Arial")
  brandTagline       String?
  location           String?
  websiteUrl         String?
  linkedinUrl        String?
  facebookUrl        String?
  instagramUrl       String?
  xUrl               String?
  youtubeUrl         String?
  contactEmail       String?
  contactPhone       String?
  preferredTone      String?
  callToAction       String?
  hospitalPhotoUrls  Json?
  preferredAsrModel  String              @default("whisper-1")
  customSystemPrompt String?             @db.Text
  defaultDisclaimer  String              @default("This clinical summary is generated under NMC registered medical practitioner supervision.")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @default(now()) @updatedAt

  users              User[]
  cases              Case[]
  departments        Department[]
  roles              Role[]
  complianceRules    ComplianceRule[]
  channelDefinitions ChannelDefinition[]
  recordings         AudioRecording[]
  sources            CaseSource[]
  usageLogs          AIUsageLog[]
  publicationJobs    PublicationJob[]
  publicationConnections PublicationConnection[]
  imageGenerationJobs ImageGenerationJob[]
  aiPromptTemplates  AiPromptTemplate[]
  auditLogs          AuditLog[]
  subscription       Subscription?
  paymentTransactions PaymentTransaction[]

  @@index([createdAt])

  @@schema("macula")
  @@map("organizations")
}

model Department {
  id             String        @id @default(uuid())
  name           String
  code           String?
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt

  @@schema("macula")
  @@map("departments")
}

model Specialty {
  id        String   @id @default(uuid())
  name      String   @unique
  category  String   @default("Other Clinical")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([isActive, sortOrder, name])
  @@schema("macula")
  @@map("specialties")
}

model Role {
  id              String           @id @default(uuid())
  name            String
  slug            String
  description     String?
  isSystem        Boolean          @default(false)
  definitionId    String?
  definition      RoleDefinition?  @relation(fields: [definitionId], references: [id], onDelete: SetNull)
  organizationId  String?
  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users           User[]
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt

  @@schema("macula")
  @@map("roles")
}

model RoleDefinition {
  id                String                         @id @default(uuid())
  slug              String                         @unique
  name              String
  description       String?
  isSystem          Boolean                        @default(false)
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @default(now()) @updatedAt
  roles             Role[]
  defaultPermissions RoleDefinitionPermission[]

  @@schema("macula")
  @@map("role_definitions")
}

model Permission {
  id              String           @id @default(uuid())
  name            String
  slug            String           @unique
  module          String?
  description     String?
  taskDefinitionId String?
  taskDefinition  TaskDefinition?  @relation(fields: [taskDefinitionId], references: [id], onDelete: SetNull)
  rolePermissions RolePermission[]
  defaultRoleDefinitions RoleDefinitionPermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt

  @@schema("macula")
  @@map("permissions")
}

model TaskDefinition {
  id          String       @id @default(uuid())
  slug        String       @unique
  name        String
  module      String?
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt
  permissions Permission[]

  @@schema("macula")
  @@map("task_definitions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@schema("macula")
  @@map("role_permissions")
}

model RoleDefinitionPermission {
  roleDefinitionId String
  permissionId     String
  roleDefinition   RoleDefinition @relation(fields: [roleDefinitionId], references: [id], onDelete: Cascade)
  permission       Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@id([roleDefinitionId, permissionId])
  @@schema("macula")
  @@map("role_definition_permissions")
}

model User {
  id             String           @id @default(uuid())
  email          String           @unique
  passwordHash   String?          @map("password_hash")
  name           String
  role           UserRole?        @default(PHYSICIAN)
  roleId         String?
  assignedRole   Role?            @relation(fields: [roleId], references: [id], onDelete: SetNull)
  specialty      String?
  registrationNo String?
  qualifications String?
  designation    String?
  profilePhotoUrl String?
  profilePhotoR2Key String?
  mustSetPassword Boolean          @default(false)
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  isSuperAdmin   Boolean          @default(false)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt

  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  cases          Case[]
  recordings     AudioRecording[]
  sources        CaseSource[]
  sessions       Session[]
  auditLogs      AuditLog[]

  @@index([organizationId, name])
  @@index([organizationId, specialty])

  @@schema("macula")
  @@map("users")
}

model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@schema("macula")
  @@map("sessions")
}

model Case {
  id              String           @id @default(uuid())
  title           String
  speciality      String?          @map("speciality")
  targetAudience  String?          @map("target_audience")
  rawInput        String           @default("") @db.Text @map("raw_input")
  guidedSubmission Json?
  masterRecord    Json
  safetyAudit     Json
  synthesisPromptTemplateId String?
  synthesisPromptVersion   Int?
  status          CaseStatus       @default(DRAFT)

  // RFP §6 — the MCCR approval gate is separate from, and must precede,
  // per-platform asset generation. mccrApprovedAt being null means the
  // Adaptation Engine has not been unlocked for this case yet.
  mccrApprovedAt  DateTime?        @map("mccr_approved_at")
  mccrApprovedBy  String?          @map("mccr_approved_by")

  rejectionReason String?          @db.Text @map("rejection_reason")
  reviewedBy      String?          @map("reviewed_by")
  reviewedAt      DateTime?        @map("reviewed_at")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt

  physicianId     String
  physician       User             @relation(fields: [physicianId], references: [id])

  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id])

  assets          GeneratedAsset[]
  recordings      AudioRecording[]
  sources         CaseSource[]
  versions        CaseVersion[]
  usageLogs       AIUsageLog[]
  publicationJobs PublicationJob[]
  seoKeywords     SeoKeywordSet?
  images          ImageAsset[]
  safetyFlags     SafetyFlag[]
  auditLogs       AuditLog[]
  imageGenerationJobs ImageGenerationJob[]

  @@index([physicianId])
  @@index([organizationId])
  @@index([createdAt])
  @@index([speciality])
  @@index([organizationId, status, createdAt])
  @@schema("macula")
  @@map("cases")
}

model GeneratedAsset {
  id          String        @id @default(uuid())
  channelKey  String        @default("DEFAULT")
  channelName String        @default("Default Channel")
  outputType  OutputType?
  variant     String?       // e.g. "45s" / "60s" / "3min" for VIDEO_SCRIPT
  content     Json
  validationWarnings Json?
  validationWordCount Int?
  validationCharacterCount Int?
  validationDurationSeconds Int?
  status      AssetStatus   @default(DRAFT)
  version     Int           @default(1)
  promptTemplateId      String?
  promptTemplateVersion String?
  modelUsed             String?
  videoR2Key            String?
  videoStorageUrl       String?
  videoDurationSeconds  Int?
  videoStatus           String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt

  caseId      String
  case        Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)

  versions    AssetVersion[]
  safetyFlags SafetyFlag[]
  publicationJobs PublicationJob[]
  seoMetadata SeoContentMetadata?

  @@unique([caseId, channelKey])
  @@index([caseId])
  @@schema("macula")
  @@map("generated_assets")
}

model CaseVersion {
  id           String     @id @default(uuid())
  version      Int
  changeType   String     @default("synthesis")
  rawInput     String     @db.Text
  guidedSubmission Json?
  masterRecord Json
  safetyAudit  Json
  status       CaseStatus
  createdAt    DateTime   @default(now())

  caseId       String
  case         Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, version])
  @@index([caseId])
  @@schema("macula")
  @@map("case_versions")
}

model AIUsageLog {
  id                  String       @id @default(uuid())
  operation           String
  provider            String
  model               String
  inputTokens         Int?
  outputTokens        Int?
  audioSeconds        Int?
  estimatedCostUsd    Decimal?     @db.Decimal(12, 6)
  metadata            Json?
  createdAt           DateTime     @default(now())

  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  caseId              String?
  case                Case?        @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([caseId])
  @@index([operation])
  @@schema("macula")
  @@map("ai_usage_logs")
}

model PublicationJob {
  id             String           @id @default(uuid())
  platform       String
  status         PublicationStatus @default(QUEUED)
  scheduledAt    DateTime?
  publishedAt    DateTime?
  externalId     String?
  failureReason  String?          @db.Text
  attemptCount   Int              @default(0)
  nextAttemptAt  DateTime?
  lastAttemptAt  DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt

  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  caseId         String
  case           Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  assetId        String
  asset          GeneratedAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, status, scheduledAt])
  @@index([organizationId, createdAt])
  @@index([status, nextAttemptAt])
  @@index([scheduledAt])
  @@schema("macula")
  @@map("publication_jobs")
}

model PublicationConnection {
  id                    String   @id @default(uuid())
  platform              String
  accountLabel          String?
  externalAccountId     String?
  accessTokenEncrypted  String?  @db.Text
  refreshTokenEncrypted String?  @db.Text
  webhookUrlEncrypted   String?  @db.Text
  expiresAt             DateTime?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now()) @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, platform, externalAccountId])
  @@index([organizationId, platform, isActive])
  @@schema("macula")
  @@map("publication_connections")
}

model Plan {
  id               String         @id @default(uuid())
  name             String         @unique
  sortOrder        Int            @default(0)
  monthlyCaseLimit Int?
  monthlyAudioMinutes Int?
  monthlyAiTokens  Int?
  monthlyAssetLimit Int?
  monthlyPrice     Decimal?       @db.Decimal(12, 2)
  currency         String         @default("INR")
  billingInterval  String         @default("monthly")
  setupFee         Decimal?       @db.Decimal(12, 2)
  isCustom         Boolean        @default(false)
  overagePolicy    String?        @db.Text
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt

  subscriptions    Subscription[]

  @@schema("macula")
  @@map("plans")
}

model Subscription {
  id             String             @id @default(uuid())
  status         SubscriptionStatus  @default(TRIAL)
  currentPeriodStart DateTime        @default(now())
  currentPeriodEnd   DateTime
  externalCustomerId String?
  externalSubscriptionId String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @default(now()) @updatedAt

  organizationId String             @unique
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId         String
  plan           Plan               @relation(fields: [planId], references: [id])

  @@index([status, currentPeriodEnd])
  @@schema("macula")
  @@map("subscriptions")
}

model PaymentTransaction {
  id              String   @id @default(uuid())
  provider        String   @default("RAZORPAY")
  orderId         String   @unique
  paymentId       String?
  signature       String?
  amount          Int
  currency        String
  status          String   @default("PENDING")
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId         String

  @@index([organizationId, status, createdAt])
  @@index([planId])
  @@schema("macula")
  @@map("payment_transactions")
}

// RFP §17 — "Retain version history". A snapshot is written every time an
// asset is edited or regenerated, so nothing is destructively overwritten.
model AssetVersion {
  id        String         @id @default(uuid())
  version   Int
  content   Json
  changeType String        @default("regenerate") // "regenerate" | "manual_edit" | "transform"
  createdAt DateTime       @default(now())

  assetId   String
  asset     GeneratedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@schema("macula")
  @@map("asset_versions")
}

// RFP §12 — searchable/publishable SEO fields are stored separately from the
// generic asset payload while the original generated JSON remains available.
model SeoContentMetadata {
  id                           String   @id @default(uuid())
  contentType                  String?
  seoTitle                     String?
  h1                           String?
  urlSlug                      String?
  metaTitle                    String?
  metaDescription              String?  @db.Text
  primaryKeyword               String?
  secondaryKeywords            Json
  longTailKeywords             Json
  searchIntent                 String?
  suggestedHeadings            Json
  fullArticle                  String?  @db.Text
  faqSection                   Json
  internalLinkSuggestions     Json
  externalReferenceSuggestions Json
  imageAltText                 String?
  featuredImageBrief           String?  @db.Text
  schemaRecommendations        Json
  internalLinkVerification     Json
  externalLinkVerification     Json
  linkVerificationStatus       String   @default("UNRESOLVED")
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @default(now()) @updatedAt

  assetId String         @unique
  asset   GeneratedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([contentType])
  @@index([primaryKeyword])
  @@schema("macula")
  @@map("seo_content_metadata")
}

model ComplianceRule {
  id             String        @id @default(uuid())
  ruleType       String        @default("DPDP_REDACTION")
  severity       String?       @default("MEDIUM")
  patternOrCheck String        @default("") @db.Text
  description    String        @default("")
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@schema("macula")
  @@map("compliance_rules")
}

model ChannelDefinition {
  id             String        @id @default(uuid())
  channelKey     String        @default("DEFAULT")
  displayName    String        @default("Default Channel")
  outputType     OutputType?   // maps this channel to one of the RFP's required output types
  targetAudience String        @default("Clinical")
  systemPrompt   String        @default("") @db.Text
  promptVersion  Int           @default(1)
  wordCountMin   Int?
  wordCountMax   Int?
  durationLabel  String?       // for VIDEO_SCRIPT variants: "45s" | "60s" | "90s" | "2min" | "3min"
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@schema("macula")
  @@map("channel_definitions")
}

model PlatformTemplate {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String?
  content     String   @db.Text
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@schema("macula")
  @@map("platform_templates")
}

model AiPromptTemplate {
  id             String   @id @default(uuid())
  promptKey      String   // "IMAGE_GENERATION" | "IMAGE_SAFETY"
  definitionId   String?
  definition     AiPromptDefinition? @relation(fields: [definitionId], references: [id], onDelete: SetNull)
  content        String   @db.Text
  version        Int      @default(1)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, promptKey, version])
  @@index([organizationId, promptKey, isActive])
  @@schema("macula")
  @@map("ai_prompt_templates")
}

model AiPromptDefinition {
  id          String             @id @default(uuid())
  promptKey   String             @unique
  name        String
  description String?
  isSystem    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @default(now()) @updatedAt
  templates   AiPromptTemplate[]

  @@schema("macula")
  @@map("ai_prompt_definitions")
}

model PlatformLimit {
  id             String   @id @default(uuid())
  platform       String   @unique
  maxCharacters  Int?
  updatedAt      DateTime @default(now()) @updatedAt

  @@schema("macula")
  @@map("platform_limits")
}

model SeoKeywordSet {
  id                String   @id @default(uuid())
  primaryKeyword    String?
  secondaryKeywords Json
  longTailKeywords  Json
  localKeywords     Json
  questionKeywords  Json
  semanticKeywords  Json
  searchIntent      String?
  qualityScore      Int?
  validationIssues  Json?
  contentHash       String?
  reviewedAt        DateTime?
  reviewedBy        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  caseId            String   @unique
  case              Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@schema("macula")
  @@map("seo_keyword_sets")
}

// RFP §16 — Medical Content Safety Layer. Flags are detected and recorded
// here; they are never used as an excuse to silently edit or drop content,
// and case/asset approval must check for open flags before proceeding.
model SafetyFlag {
  id         String               @id @default(uuid())
  targetType SafetyFlagTargetType
  detail     String               @db.Text
  flagType   String               // "pii" | "phi" | "claim" | "face" | "other"
  confidence String               @default("medium") // "high" | "medium" | "low"
  status     SafetyFlagStatus     @default(OPEN)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime             @default(now())

  caseId        String?
  case          Case?             @relation(fields: [caseId], references: [id], onDelete: Cascade)

  generatedAssetId String?
  generatedAsset    GeneratedAsset? @relation(fields: [generatedAssetId], references: [id], onDelete: Cascade)
  imageAssetId    String?
  imageAsset      ImageAsset? @relation(fields: [imageAssetId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([status])
  @@index([status, createdAt])
  @@index([caseId, status, createdAt])
  @@schema("macula")
  @@map("safety_flags")
}

// RFP §14-15 — supporting/generated images per channel aspect ratio, with
// the explicit public-use consent toggle. Never auto-published.
model ImageAsset {
  id                 String   @id @default(uuid())
  channel            String   // "linkedin_cover" | "linkedin_carousel" | "facebook_post" | "ig_reels" | "x_image" | "yt_thumbnail" | "blog_featured"
  sourceType         String   @default("ai_generated") // "ai_generated" | "doctor_uploaded"
  r2Key              String?
  storageUrl         String?
  publicUseApproved  Boolean  @default(false)
  consentConfirmed   Boolean  @default(false) // doctor confirmed patient-identifying info removed / consent exists
  phiReviewStatus    String   @default("PENDING") // "PENDING" | "CLEAR" | "FLAGGED"
  ocrText            String?  @db.Text
  safetyFindings     Json?
  generationPromptTemplateId String?
  generationPromptVersion   Int?
  safetyPromptTemplateId     String?
  safetyPromptVersion       Int?
  faceDetected       Boolean  @default(false)
  screenedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  caseId             String
  case                Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  safetyFlags        SafetyFlag[]

  @@index([caseId])
  @@schema("macula")
  @@map("image_assets")
}

model ImageGenerationJob {
  id           String   @id @default(uuid())
  channel      String
  conceptBrief String?  @db.Text
  status       String   @default("QUEUED") // "QUEUED" | "PROCESSING" | "COMPLETED" | "FAILED"
  error        String?  @db.Text
  createdAt    DateTime @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  caseId       String
  case         Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([caseId])
  @@schema("macula")
  @@map("image_generation_jobs")
}

model AuditLog {
  id             String   @id @default(uuid())
  action         String
  targetType     String
  targetId       String
  detail         String?  @db.Text
  metadata       Json?
  createdAt      DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String?
  actor          User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  caseId         String?
  case           Case?    @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([targetType, targetId])
  @@index([caseId, createdAt])
  @@schema("macula")
  @@map("audit_logs")
}

model AudioRecording {
  id                  String        @id @default(uuid())
  r2Key               String
  storageUrl          String
  fileName            String
  durationSeconds     Int           @default(0)
  recordedAt          DateTime      @default(now())
  transcriptionStatus String        @default("PENDING")
  rawTranscript       String?       @db.Text
  transcribedText     String?       @db.Text
  transcriptionAgent  String?
  refinerAgent        String?       @default("gpt-4o")
  refinerPromptTemplateId String?
  refinerPromptVersion   Int?
  mimeType            String        @default("audio/webm")

  userId              String?
  user                User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  organizationId      String
  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  caseId              String?
  case                Case?         @relation(fields: [caseId], references: [id], onDelete: SetNull)

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @default(now()) @updatedAt

  @@index([organizationId])
  @@index([userId])
  @@schema("macula")
  @@map("audio_recordings")
}

enum CaseSourceType {
  DOCUMENT
  VIDEO

  @@schema("macula")
}

enum CaseSourceStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED

  @@schema("macula")
}

model CaseSource {
  id             String           @id @default(uuid())
  sourceType     CaseSourceType
  status         CaseSourceStatus  @default(UPLOADED)
  fileName       String
  mimeType       String
  r2Key          String
  storageUrl     String
  extractedText  String?           @db.Text
  processingError String?          @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @default(now()) @updatedAt

  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  caseId         String
  case           Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([caseId])
  @@index([status])
  @@schema("macula")
  @@map("case_sources")
}
