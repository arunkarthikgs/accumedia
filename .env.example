# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://user:password@localhost:5432/macula"
# Add DIRECT_URL matching your database instance
DIRECT_URL="postgresql://user:password@localhost:5432/macula"
HYPERDRIVE_URL="postgresql://user:password@localhost:5432/macula"
ANTHROPIC_API_KEY="your_anthropic_key"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Razorpay payments (server-side secret stays private; key ID is returned to checkout)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

DB_NAME="postgres"
DB_USER="user"
DB_PASS="password"
DB_HOST="localhost"
DB_PORT="5432"

# Cloudflare R2 (S3-compatible)
R2_BUCKET_NAME="accumedia"
R2_PUBLIC_DOMAIN="https://your-r2-domain.example.com"

R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# OpenAI API Key (for Whisper speech-to-text)
OPENAI_API_KEY="your_openai_api_key"

# Global default model ('whisper-1', 'deepgram-nova-3-medical', or 'faster-whisper-self-hosted')
DEFAULT_ASR_MODEL="whisper-1"
# Production privacy gate: set true only when external ASR processing is approved.
ALLOW_EXTERNAL_ASR="false"

# Keys for the respective providers
OPENAI_API_KEY="sk-..."
DEEPGRAM_API_KEY="your-deepgram-api-key"
SELF_HOSTED_ASR_ENDPOINT="http://localhost:8000/v1/audio/transcriptions"

# Publishing OAuth (configure only the providers you enable)
AUTH_SECRET="replace-with-a-long-random-secret"
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
META_CLIENT_ID=""
META_CLIENT_SECRET=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
PUBLISHING_CRON_SECRET="replace-with-a-long-random-secret"

# Optional image safety service. It must return { faceDetected, findings }.
IMAGE_SAFETY_ENDPOINT=""
# Set true to fail uploads when local OCR cannot run.
IMAGE_SAFETY_REQUIRED="false"
# Set true to use GPT-4o vision for face/PHI/entity screening.
IMAGE_SAFETY_AI="false"
IMAGE_SAFETY_AI_MODEL="gpt-4o"

# Development/demo login provisioning; override these before running prisma/seed-auth.ts.
DEMO_SUPERADMIN_PASSWORD=""
DEMO_ADMIN_PASSWORD=""
DEMO_DOCTOR_PASSWORD=""
