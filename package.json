    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.11",
    "postcss": "^8.4.47",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.6.2",
    "wrangler": "^4.132.0"
  }
}
