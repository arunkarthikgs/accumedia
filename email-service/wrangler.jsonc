{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "accumedia-email-service",
  "main": "./worker.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "EmailService",
      "image": "./Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "EMAIL_SERVICE", "class_name": "EmailService" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EmailService"] }],
  "dev": { "enable_containers": true }
}
