{
  "name": "macula-healthcare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview:worker": "opennextjs-cloudflare preview",
    "deploy": "npm run build:worker && wrangler deploy --config wrangler.toml",
    "start": "next start",
    "deploy:scheduler": "wrangler deploy --config wrangler.scheduler.toml",
    "deploy:video-renderer": "wrangler deploy --config video-render-cloudflare/wrangler.jsonc",
    "dev:scheduler": "wrangler dev --config wrangler.scheduler.toml",
    "lint": "next lint",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.654.0",
    "@aws-sdk/s3-request-presigner": "^3.654.0",
    "@cloudflare/containers": "^0.3.7",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.441.0",
    "mammoth": "^1.12.3",
    "next": "14.2.11",
    "openai": "^4.61.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^2.5.2",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.14.0",
